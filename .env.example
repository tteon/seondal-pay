# Copy to .env and fill in. NEVER commit .env (gitignored).

# --- Database (optional — mock JSON fallback when unset) ---
DB_USER=db_user
DB_PASS=
DB_NAME=app_db
# DB_HOST=127.0.0.1            # via Cloud SQL Auth Proxy on GKE
# INSTANCE_CONNECTION_NAME=project:region:instance   # via Cloud Run/Cloud SQL

# --- App ---
PORT=3000
NODE_ENV=production
GCS_BUCKET=

# --- LLM providers (optional — rule-based fallback when unset) ---
KIMI_API_KEY=
MARA_API_KEY=

# --- Experiments (Kimi K3, per-condition billing keys) ---
KIMI_KEY_NON_ONTOLOGY=
KIMI_KEY_ONTOLOGY=

# --- Coupang (Seller API; product info only — never settlement) ---
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=
COUPANG_SUB_ID=seondal

# --- Alerts ---
DISCORD_WEBHOOK_URL=
ROI_ALERT_MIN_PERCENT=40

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=seondal-pay

# --- MPP payment layer ---
MPP_CHALLENGE_TTL_SECONDS=300
MPP_REALM=seocho-pay
MPP_SOLANA_NETWORK=devnet
PUBLIC_BASE_URL=http://localhost:3000
